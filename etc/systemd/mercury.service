[Unit]
Description=mercury - MERCURY softmodem for pi
After=network.target sound.target

[Service]
ExecStartPre=+systemctl stop fldigi sstv wsjtx tnc300b digipeater ardop tnc node js8call winlinkrms tracker webchat
ExecStart=/home/pi/mercury.sh 
User=pi
Restart=no
WorkingDirectory=/home/pi/

[Install]
WantedBy=multi-user.target
